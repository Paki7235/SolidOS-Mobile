#!/bin/sh
# Avvio automatico con OpenRC (con systemd ci pensano i collegamenti nel pacchetto)
command -v rc-update >/dev/null || exit 0
rc-update add solidos-mobile default 2>/dev/null
rc-update add networkmanager default 2>/dev/null
rc-update add modemmanager default 2>/dev/null
rc-update add bluetooth default 2>/dev/null
exit 0
